/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
    ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    // Pre-existing invalid stubs (import missing symbols). Unrelated contact-form debt — see docs/contact-form-secrets-and-ops.md
    "src/app/services/auth.spec.ts",
    "src/app/services/sanitization.spec.ts"
  ]
}

